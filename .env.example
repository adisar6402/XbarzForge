# ─── OpenAI ─────────────────────────────────────────────────────────────────
# Required for AI analysis, doc generation, and chat features.
# Without this key, AI features are gracefully disabled and the app still works.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Clerk Authentication ────────────────────────────────────────────────────
# Create a free application at https://clerk.com → Dashboard → API Keys
# VITE_ prefix exposes the key to the React frontend at build time.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ─── Session ─────────────────────────────────────────────────────────────────
# A random secret string for session encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-random-64-char-hex-string

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local:  postgresql://postgres:password@localhost:5432/xbarzforge
# Render: provided automatically when you add a Render PostgreSQL database
DATABASE_URL=postgresql://user:password@host:5432/xbarzforge

# ─── Server ──────────────────────────────────────────────────────────────────
# API server port (defaults to 8080 if not set)
PORT=8080

# Node environment — controls logging verbosity and static file serving
NODE_ENV=development

# ─── Frontend Build (set these when building the frontend manually) ───────────
# Base path for Vite build. Use '/' for local dev and production on Render.
# On Replit this is set automatically to the artifact path.
BASE_PATH=/

# ─── Production Only ─────────────────────────────────────────────────────────
# Path to the built frontend files (relative to where the API server runs from).
# Only needed in production when the API server serves the frontend.
# STATIC_DIR=artifacts/xbarzforge/dist/public
